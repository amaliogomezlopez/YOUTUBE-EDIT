# LLM provider for clip scoring and publishing metadata.
# MiniMax M3 example:
LLM_PROVIDER=minimax
LLM_BASE_URL=https://api.minimax.io/v1/text/chatcompletion_v2
LLM_API_KEY=
LLM_MODEL=MiniMax-M3
LLM_TIMEOUT_MS=120000
LLM_RETRIES=2

# Optional aliases accepted by the app.
MINIMAX_API_URL=https://api.minimax.io/v1/text/chatcompletion_v2
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3
OPENCODE_BASE_URL=
OPENCODE_API_KEY=
OPENCODE_MODEL=

# LLM multimodal independiente para scouting visual de animaciones.
# Solo recibe hojas de contacto JPEG; no se le envía el vídeo, el audio ni una transcripción.
VISION_LLM_PROVIDER=openai-compatible
VISION_LLM_BASE_URL=https://api.openai.com/v1
VISION_LLM_API_KEY=
VISION_LLM_MODEL=
VISION_LLM_IMAGE_DETAIL=high
VISION_LLM_MAX_IMAGES_PER_REQUEST=4
VISION_LLM_TIMEOUT_MS=180000
VISION_LLM_RETRIES=2
# Desactívalo si el endpoint no admite response_format=json_object.
VISION_LLM_JSON_MODE=true

# Optional OpenAI-compatible local fallback example:
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1:8b

# Local transcription with word timestamps. Install it with: npm run stt:setup
TRANSCRIPTION_PROVIDER=faster-whisper
TRANSCRIPTION_MODEL=small
TRANSCRIPTION_LANGUAGE=auto
FASTER_WHISPER_DEVICE=cuda
FASTER_WHISPER_COMPUTE_TYPE=float16
# Optional overrides. Defaults point to .venv-whisper and data/models/faster-whisper.
FASTER_WHISPER_PYTHON=
FASTER_WHISPER_MODEL_DIR=
FASTER_WHISPER_BEAM_SIZE=5
# Optional comma-separated proper names and technical vocabulary.
FASTER_WHISPER_INITIAL_PROMPT=
TRANSCRIPTION_CHUNK_SECONDS=600
TRANSCRIPTION_CHUNK_OVERLAP_SECONDS=3
TRANSCRIPTION_TIMEOUT_MS=3600000
TRANSCRIPTION_RETRIES=2

# Optional cloud STT alternative. Leave disabled for a fully local workflow.
# STT_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Future publishing API credentials. Never commit real tokens.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/oauth/youtube/callback
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CATEGORY_ID=22
META_GRAPH_VERSION=v23.0
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/oauth/instagram/callback
META_INSTAGRAM_SCOPES=pages_show_list,pages_read_engagement,instagram_basic,instagram_content_publish
META_INSTAGRAM_OMIT_SCOPES=false
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://sibelion.ddns.net:8443/shortsmith/oauth/app/tiktok/callback/
TIKTOK_SCOPES=user.info.basic,user.info.profile,video.upload,video.publish
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_OPEN_ID=
# direct publishes without a second TikTok step; unaudited apps are restricted to SELF_ONLY.
TIKTOK_PUBLISH_MODE=direct
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://127.0.0.1:3000/api/oauth/x/callback
X_SCOPES=tweet.read,tweet.write,users.read,offline.access,media.write
X_USER_ACCESS_TOKEN=
X_REFRESH_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Optional HTTPS asset host for Instagram Reels. Instagram Graph API needs a
# public HTTPS video_url; local MP4 files are uploaded here before publishing.
ASSET_HOST_PROVIDER=
ASSET_HOST_SSH_HOST=
ASSET_HOST_SSH_PORT=22
ASSET_HOST_SSH_USER=
ASSET_HOST_SSH_KEY_PATH=
ASSET_HOST_REMOTE_DIR=
ASSET_HOST_PUBLIC_BASE_URL=

# Server
PORT=3000
HOST=127.0.0.1
# Required (24+ chars) when HOST is not loopback. Put Shortsmith behind HTTPS.
SHORTSMITH_AUTH_TOKEN=
SHORTSMITH_ALLOWED_HOSTS=
SHORTSMITH_ALLOWED_ORIGINS=
SHORTSMITH_ALLOWED_MEDIA_ROOTS=
SHORTSMITH_MUTATION_RATE_LIMIT=120
# Finance editorial channel UI remains hidden until the assisted pilot is ready.
SHORTSMITH_EDITORIAL_VIDEO_UI_ENABLED=false

# Optional editorial asset discovery. Offline logo packages work without keys.
# Pexels and Pixabay offer free media search APIs. Brandfetch Search/Logo are
# optional and use a free Client ID subject to their published rate limits.
# Keys stay on the local server and are never included in Remotion props or
# browser responses.
PEXELS_API_KEY=
PIXABAY_API_KEY=
BRANDFETCH_CLIENT_ID=

# Queues, storage and retention.
JOB_CONCURRENCY=1
PUBLISH_CONCURRENCY=1
JOB_RETRY_DELAY_MS=1500
PUBLISH_RETRY_DELAY_MS=3000
SHORTSMITH_MAX_UPLOAD_BYTES=21474836480
SHORTSMITH_MAX_TRANSCRIPT_BYTES=104857600
SHORTSMITH_DISK_RESERVE_BYTES=5368709120
SHORTSMITH_TEMP_RETENTION_HOURS=24
# Disabled by default; set >0 only if old jobs/renders may be deleted.
SHORTSMITH_JOB_RETENTION_DAYS=0
