{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shortsmith.local/schemas/image-asset-manifest.schema.json",
  "title": "Shortsmith managed image manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "images"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "publicPath",
          "alt",
          "width",
          "height",
          "sha256",
          "source",
          "license",
          "tags"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "publicPath": {
            "type": "string",
            "pattern": "^assets/library/"
          },
          "alt": {
            "type": "string",
            "minLength": 1
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "author": {
            "type": "string"
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "attribution": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "focalPoint": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        }
      }
    }
  }
}
