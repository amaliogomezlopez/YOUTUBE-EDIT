{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shortsmith.local/schemas/visual-selection.schema.json",
  "title": "Shortsmith semantic visual selection result",
  "description": "Resultado auditable del selector de iconos, dibujos e imágenes gestionadas.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "query",
    "kind",
    "mode",
    "selected",
    "alternatives",
    "fallback",
    "semanticSignals",
    "preferenceProfile"
  ],
  "properties": {
    "version": {"const": 1},
    "query": {"type": "string", "minLength": 1},
    "kind": {
      "enum": ["any", "icon", "drawing", "image"]
    },
    "mode": {
      "enum": [
        "deterministic-catalog",
        "llm-catalog-validated",
        "controlled-fallback",
        "no-match"
      ]
    },
    "selected": {
      "oneOf": [
        {"$ref": "#/$defs/rankedAsset"},
        {"type": "null"}
      ]
    },
    "alternatives": {
      "type": "array",
      "items": {"$ref": "#/$defs/rankedAsset"}
    },
    "fallback": {
      "oneOf": [
        {"$ref": "#/$defs/controlledFallback"},
        {"type": "null"}
      ]
    },
    "semanticSignals": {
      "type": "object",
      "required": ["concepts", "expandedTerms", "relationshipIntent"],
      "properties": {
        "concepts": {"type": "array", "items": {"type": "string"}},
        "expandedTerms": {"type": "array", "items": {"type": "string"}},
        "relationshipIntent": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "preferenceProfile": {
      "oneOf": [
        {"type": "string"},
        {"type": "null"}
      ]
    }
  },
  "$defs": {
    "rankedAsset": {
      "type": "object",
      "required": ["id", "kind", "score", "matches"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {
          "enum": ["icon", "drawing", "image"]
        },
        "score": {"type": "number", "minimum": 0},
        "matches": {
          "type": "array",
          "items": {"type": "string"}
        },
        "rationale": {"type": "string"}
      },
      "additionalProperties": true
    },
    "controlledFallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "layout",
        "iconIds",
        "generationPolicy",
        "rationale"
      ],
      "properties": {
        "kind": {"const": "controlled-composite"},
        "layout": {
          "enum": ["flow", "cluster"]
        },
        "iconIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {"type": "string"}
        },
        "generationPolicy": {
          "const": "catalog-only-no-freeform-svg"
        },
        "rationale": {"type": "string", "minLength": 1},
        "recipe": {
          "type": "object",
          "required": ["version", "primitives", "connectors", "editable"],
          "properties": {
            "version": {"const": 1},
            "primitives": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["iconId", "role"],
                "properties": {
                  "iconId": {"type": "string"},
                  "role": {"enum": ["primary", "supporting"]}
                },
                "additionalProperties": false
              }
            },
            "connectors": {"enum": ["semantic-flow", "none"]},
            "editable": {"const": true}
          },
          "additionalProperties": false
        }
      }
    }
  }
}
