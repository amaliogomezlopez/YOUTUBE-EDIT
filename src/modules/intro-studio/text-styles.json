    "highlight": "underline: subrayado en acento que barre bajo la palabra resaltada; italic: la palabra resaltada en cursiva",
    "stat.presentation": "column (columna lateral con el sujeto a un lado, la v3) | floating (cifra sobre el video, sin panel, con oscurecido radial)",
    "stat.counter": "true: la cifra cuenta desde 0 hasta su valor"
