{
  "name": "shortsmith-mvp",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Local creator workflow for transcripts, vertical clips, metadata, stories and official multi-platform publishing.",
  "scripts": {
    "process": "node src/cli.js process",
    "carousel": "node src/modules/carousels/cli.js",
    "server": "node src/server.js",
    "test": "node --test tests/*.test.js",
    "smoke": "node tests/smoke-e2e.js",
    "remotion:studio": "npm --prefix remotion-animations run dev",
    "remotion:check": "npm --prefix remotion-animations run check",
    "remotion:still": "npm --prefix remotion-animations run still:chart",
    "remotion:render": "npm --prefix remotion-animations run render:chart",
    "remotion:overlay": "npm --prefix remotion-animations run render:overlay",
    "remotion:render:ahorrar-limites-v2": "npm --prefix remotion-animations run render:ahorrar-limites-v2",
    "remotion:render:ahorrar-limites-v3-audio": "npm --prefix remotion-animations run render:ahorrar-limites-v3-audio",
    "remotion:render:toolkit": "npm --prefix remotion-animations run render:toolkit",
    "instagram:doctor": "node scripts/instagram-doctor.js",
    "instagram:refresh-token": "node scripts/instagram-refresh-token.js",
    "instagram:redeem-vps-code": "node scripts/instagram-redeem-vps-code.js",
    "publishing:doctor": "node scripts/publishing-doctor.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "onnxruntime-node": "^1.22.0",
    "sharp": "^0.35.3"
  }
}
